{
  "name": "todoist-backend",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check": "node --check src/server.js",
    "migration:create": "typeorm migration:create",
    "migration:generate": "typeorm migration:generate -d src/data-source.js",
    "migration:run": "typeorm migration:run -d src/data-source.js",
    "migration:revert": "typeorm migration:revert -d src/data-source.js",
    "migration:show": "typeorm migration:show -d src/data-source.js"
  },
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "^1.4.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "google-auth-library": "^9.14.2",
    "pg": "^8.16.3",
    "typeorm": "^0.3.26",
    "zod": "^3.25.76"
  }
}
