# Project configuration
project_id  = "narainkarthik812-practice-dev"
region      = "asia-south1"
zone        = "asia-south1-a"
environment = "dev"
app_name    = "ownlyst"

# Compute configuration
instance_type = "e2-micro"
min_replicas  = 1
max_replicas  = 2

# Monitoring configuration
enable_monitoring = false

# Backup configuration
backup_retention_days = 7

# Security configuration
allowed_ip_ranges = [
  "43.225.165.41/32" # Current public IP for secure SSH access
]

# Security configuration for development
create_service_account_keys = false
enable_workload_identity    = false
custom_permissions = [
  "storage.buckets.list",
  "storage.objects.get",
  "storage.objects.create"
]

# Cloud SQL configuration for dev
enable_cloudsql                   = true
cloudsql_instance_name            = "narainkarthik812-practice-dev-postgres"
cloudsql_database_version         = "POSTGRES_17"
cloudsql_tier                     = "db-f1-micro"
cloudsql_disk_size_gb             = 10
cloudsql_backup_retained_backups  = 7
cloudsql_backup_start_time        = "02:00"
cloudsql_private_ip_prefix_length = 24
cloudsql_authorized_networks = [
  {
    name  = "dev-open-access"
    value = "0.0.0.0/0"
  }
]
