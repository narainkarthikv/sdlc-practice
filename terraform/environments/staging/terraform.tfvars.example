# Project configuration
project_id  = "narainkarthik812-practice-staging"
region      = "asia-south1"
zone        = "asia-south1-a"
environment = "staging"
app_name    = "ownlyst"

# Compute configuration (production-grade)
instance_type = "e2-micro"
min_replicas  = 1
max_replicas  = 2

# Monitoring configuration
enable_monitoring = true

# Backup configuration (long retention)
backup_retention_days = 30

# Security configuration (most restrictive)
allowed_ip_ranges = [
  "10.0.0.0/8",    # Internal network
  "192.168.1.0/24" # Office network
]

# Security configuration for staging
create_service_account_keys = false  # Use Workload Identity instead
enable_workload_identity    = true
kubernetes_namespace        = "staging"
custom_permissions = [
  "storage.buckets.list",
  "storage.objects.get",
  "storage.objects.create",
  "cloudsql.instances.connect"
]
